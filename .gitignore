# Chezmoi gitignore

# Ignore encrypted files if you use age/gpg encryption
*.age
*.gpg

# Ignore backup files
*.bak
*~

# Ignore OS files
.DS_Store
Thumbs.db

# IMPORTANT: Never commit secrets files
# These should be created manually on each machine
.zshrc.secrets
secrets.*
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
Library

# Environment files
.env
.env.local
.env.*.local
*.env

# API keys and secrets
*.pem
*.key
*.cert
*.p12
*.pfx
*_rsa
*_rsa.pub
*.crt
*.cer

# Logs
*.log
logs/
Library/Logs/

# Node/Bun
node_modules/
.npm
.yarn
.pnp.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp

# Build outputs
dist/
build/
out/

# Cache
.cache/
*.cache

# Personal/Private data
private/
secrets/
credentials/

.claude/**
.aws/**
.ssh/id_*
