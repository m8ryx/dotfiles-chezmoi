export EDITOR='nvim'

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Source secrets file (API keys, tokens, etc.)
# This file is NOT committed to git for security
if [ -f ~/.zshrc.secrets ]; then
    source ~/.zshrc.secrets
fi

# workaroundd to use AMD ROCm v6 with my graphics card per https://docs.ollama.com/gpu#overrides-on-linux
